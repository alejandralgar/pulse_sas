# Copia este archivo a .env y completa los valores.
# .env nunca se sube al repositorio (ver .gitignore).

# Generar una propia en https://djecrety.ir/ o con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-secreta-propia

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=citas_pulse_sas
DB_USER=postgres

# Dejar en blanco: cada quien pone la contraseña y el puerto de SU Postgres local.
DB_PASSWORD=
DB_PORT=
DB_HOST=localhost

# Correo: en dev queda en consola (no envía nada real). Para producción,
# cambiar a 'django.core.mail.backends.smtp.EmailBackend' y configurar
# EMAIL_HOST/EMAIL_PORT/EMAIL_HOST_USER/EMAIL_HOST_PASSWORD.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@pulsesas.local
